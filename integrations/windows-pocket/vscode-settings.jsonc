// Pocket for VS Code: paste these keys into your user settings.json (Ctrl Shift P › "Preferences: Open User Settings (JSON)").
// They recolour VS Code's built-in Light Modern and Dark Modern themes, so nothing needs installing.
// Graphite bands label the sidebar sections, the status bar is an LCD, and orange is kept for the cursor, focus and primary buttons.
{
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Default Light Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "editor.fontFamily": "'Space Mono', 'Cascadia Mono', Consolas, monospace",
  "editor.cursorBlinking": "solid",
  "workbench.colorCustomizations": {
    "[Default Light Modern]": {
      "editor.background": "#F6F3EC",
      "editor.lineHighlightBackground": "#EBE7DD",
      "editor.selectionBackground": "#F9C2AA",
      "editorCursor.foreground": "#FF5B1F",
      "editorLineNumber.foreground": "#9A9385",
      "editorLineNumber.activeForeground": "#1B1915",
      "editorGroupHeader.tabsBackground": "#E6E2D8",
      "tab.activeBackground": "#F6F3EC",
      "tab.inactiveBackground": "#E6E2D8",
      "tab.activeBorderTop": "#FF5B1F",
      "tab.border": "#D3CCBD",
      "sideBar.background": "#EBE7DD",
      "sideBar.border": "#D3CCBD",
      "sideBarSectionHeader.background": "#2A2722",
      "sideBarSectionHeader.foreground": "#F6F3EC",
      "activityBar.background": "#2A2722",
      "activityBar.foreground": "#FF5B1F",
      "activityBar.inactiveForeground": "#A39C8D",
      "activityBarBadge.background": "#FF5B1F",
      "activityBarBadge.foreground": "#1B1915",
      "titleBar.activeBackground": "#E6E2D8",
      "titleBar.activeForeground": "#1B1915",
      "titleBar.inactiveBackground": "#E6E2D8",
      "statusBar.background": "#B1BD93",
      "statusBar.foreground": "#1F2A17",
      "statusBar.noFolderBackground": "#B1BD93",
      "statusBar.debuggingBackground": "#E9B45A",
      "statusBar.debuggingForeground": "#2A1A00",
      "panel.background": "#F6F3EC",
      "panel.border": "#D3CCBD",
      "terminal.background": "#F6F3EC",
      "terminal.foreground": "#2A2722",
      "terminalCursor.foreground": "#FF5B1F",
      "focusBorder": "#FF5B1F",
      "button.background": "#FF5B1F",
      "button.foreground": "#1B1915",
      "button.hoverBackground": "#FF7A45",
      "badge.background": "#FF5B1F",
      "badge.foreground": "#1B1915",
      "input.background": "#FBF9F4",
      "input.border": "#D3CCBD",
      "list.activeSelectionBackground": "#2A2722",
      "list.activeSelectionForeground": "#F6F3EC",
      "list.inactiveSelectionBackground": "#EED1BF",
      "list.hoverBackground": "#E6E2D8",
      "progressBar.background": "#FF5B1F"
    },
    "[Default Dark Modern]": {
      "editor.background": "#262522",
      "editor.lineHighlightBackground": "#302E2A",
      "editor.selectionBackground": "#63331D",
      "editorCursor.foreground": "#FF6A2B",
      "editorLineNumber.foreground": "#6F6A5F",
      "editorLineNumber.activeForeground": "#F4EFE5",
      "editorGroupHeader.tabsBackground": "#1A1917",
      "tab.activeBackground": "#262522",
      "tab.inactiveBackground": "#1A1917",
      "tab.activeBorderTop": "#FF6A2B",
      "tab.border": "#3F3C36",
      "sideBar.background": "#22211E",
      "sideBar.border": "#3F3C36",
      "sideBarSectionHeader.background": "#0F0E0D",
      "sideBarSectionHeader.foreground": "#ECE6DA",
      "activityBar.background": "#0F0E0D",
      "activityBar.foreground": "#FF6A2B",
      "activityBar.inactiveForeground": "#A39C8D",
      "activityBarBadge.background": "#FF6A2B",
      "activityBarBadge.foreground": "#1B1915",
      "titleBar.activeBackground": "#1A1917",
      "titleBar.activeForeground": "#F4EFE5",
      "titleBar.inactiveBackground": "#1A1917",
      "statusBar.background": "#45B3A1",
      "statusBar.foreground": "#04211C",
      "statusBar.noFolderBackground": "#45B3A1",
      "statusBar.debuggingBackground": "#E2B04F",
      "statusBar.debuggingForeground": "#2A1A00",
      "panel.background": "#262522",
      "panel.border": "#3F3C36",
      "terminal.background": "#1A1917",
      "terminal.foreground": "#E9E3D6",
      "terminalCursor.foreground": "#FF6A2B",
      "focusBorder": "#FF6A2B",
      "button.background": "#FF6A2B",
      "button.foreground": "#1B1915",
      "button.hoverBackground": "#FF8550",
      "badge.background": "#FF6A2B",
      "badge.foreground": "#1B1915",
      "input.background": "#2A2926",
      "input.border": "#3F3C36",
      "list.activeSelectionBackground": "#0F0E0D",
      "list.activeSelectionForeground": "#ECE6DA",
      "list.inactiveSelectionBackground": "#51382A",
      "list.hoverBackground": "#302E2A",
      "progressBar.background": "#FF6A2B"
    }
  }
}
