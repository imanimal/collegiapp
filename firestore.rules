rules_version = '2';

// Collegiapp sync (src-tauri/src/cloud.rs, ui/js/cloud.js, docs/SYNC.md): each Google account reads and writes only
// its own items. A write is a whole item document: `j` the item's JSON, `c` its course's, `d` the device, and `s`
// the server's time of the write, which pulls ask for, so it must be the server's time and not a device's clock.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["j", "c", "d", "s"])
        && request.resource.data.j is string
        && request.resource.data.d is string
        && request.resource.data.s == request.time;
    }
  }
}
